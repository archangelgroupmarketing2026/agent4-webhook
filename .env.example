# Copy to .env for local dev (never commit .env).
# On Render, set these in the dashboard Environment tab.

# GoHighLevel Private Integration Token (sub-account level).
# Generate in GHL: Settings -> Business Profile -> Private Integrations.
# Scopes needed: contacts.readonly, contacts.write, opportunities.readonly,
#                opportunities.write, conversations/message.write
GHL_PIT=

# GoHighLevel Location ID (sub-account). Overrides the one in config.json.
GHL_LOCATION_ID=l1d7nflxbC8vLMR1KuMa

# Local dev port (Render sets PORT automatically in production).
PORT=8000

# Log level: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO
